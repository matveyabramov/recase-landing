# Public build variables; copy to .env.layero.local or set on Layero at build time.
VITE_BASE_PATH=/
# Both Yandex forms require explicit activation for an authorized Layero release.
VITE_YANDEX_FORMS_ENABLED=false
VITE_YANDEX_PARTICIPANT_FORM_URL=https://forms.yandex.ru/u/6acf8895852af3fab5c7a14b?iframe=1
VITE_YANDEX_PARTNER_FORM_URL=https://forms.yandex.ru/u/6acfa04d2c4f89f2a71bb1ca?iframe=1
# Reserve Beget settings below do not control the active frontend.
VITE_LEAD_API_URL=https://matveyyb.beget.tech/api/lead.php
# Fill only with the confirmed production origin from Layero (no trailing slash).
VITE_SITE_ORIGIN=
# Keep false until legal approval and authorized synthetic end-to-end tests.
VITE_LEAD_API_ENABLED=false
